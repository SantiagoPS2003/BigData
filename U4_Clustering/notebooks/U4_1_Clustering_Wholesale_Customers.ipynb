   "source": [
    "from IPython.display import HTML, display\n",
    "from matplotlib.animation import FuncAnimation\n",
    "from matplotlib.lines import Line2D\n",
    "\n",
    "# Para dibujar puntos en dos dimensiones, elegimos dos variables\n",
    "variables_demo = [\"Grocery\", \"Detergents_Paper\"]\n",
    "\n",
    "# Usamos los valores ya transformados y estandarizados\n",
    "X_demo = X_preparado[variables_demo].to_numpy()\n",
    "\n",
    "k_demo = 2\n",
    "rng = np.random.default_rng(42)\n",
    "\n",
    "# K-Means comienza colocando k centroides en posiciones iniciales\n",
    "indices_iniciales = rng.choice(len(X_demo), size=k_demo, replace=False)\n",
    "centros_actuales = X_demo[indices_iniciales].copy()\n",
    "\n",
    "centros_historial = [centros_actuales.copy()]\n",
    "grupos_historial = []\n",
    "\n",
    "# Repetimos la asignación de clientes y el cálculo de centroides\n",
    "for iteracion in range(10):\n",
    "\n",
    "    # Calculamos la distancia de cada cliente a cada centroide\n",
    "    distancias_por_centro = []\n",
    "\n",
    "    for centro in centros_actuales:\n",
    "        diferencias = X_demo - centro\n",
    "        distancias = np.sqrt((diferencias ** 2).sum(axis=1))\n",
    "        distancias_por_centro.append(distancias)\n",
    "\n",
    "    # Asignamos cada cliente al centroide más cercano\n",
    "    matriz_distancias = np.array(distancias_por_centro).T\n",
    "    grupos = np.argmin(matriz_distancias, axis=1)\n",
    "\n",
    "    # Recalculamos cada centroide como el promedio de su grupo\n",
    "    nuevos_centros = centros_actuales.copy()\n",
    "\n",
    "    for grupo in range(k_demo):\n",
    "        clientes_del_grupo = X_demo[grupos == grupo]\n",
    "\n",
    "        if len(clientes_del_grupo) > 0:\n",
    "            nuevos_centros[grupo] = clientes_del_grupo.mean(axis=0)\n",
    "\n",
    "    grupos_historial.append(grupos.copy())\n",
    "    centros_historial.append(nuevos_centros.copy())\n",
    "\n",
    "    # Si los centroides ya no se mueven, el algoritmo terminó\n",
    "    if np.allclose(centros_actuales, nuevos_centros):\n",
    "        break\n",
    "\n",
    "    centros_actuales = nuevos_centros\n",
    "\n",
    "\n",
    "# Preparamos la gráfica animada\n",
    "colores = np.array(sns.color_palette(\"Set2\", n_colors=k_demo))\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 7))\n",
    "\n",
    "puntos = ax.scatter(\n",
    "    X_demo[:, 0],\n",
    "    X_demo[:, 1],\n",
    "    color=\"lightgray\",\n",
    "    alpha=0.65,\n",
    "    s=40\n",
    ")\n",
    "\n",
    "centroides = ax.scatter(\n",
    "    centros_historial[0][:, 0],\n",
    "    centros_historial[0][:, 1],\n",
    "    marker=\"X\",\n",
    "    s=250,\n",
    "    c=colores,\n",
    "    edgecolor=\"black\",\n",
    "    linewidth=1.5,\n",
    "    zorder=3\n",
    ")\n",
    "\n",
    "# Dibujamos una línea para mostrar el recorrido de cada centroide\n",
    "lineas_recorrido = []\n",
    "\n",
    "for grupo in range(k_demo):\n",
    "    linea, = ax.plot(\n",
    "        [],\n",
    "        [],\n",
    "        color=colores[grupo],\n",
    "        linestyle=\"--\",\n",
    "        alpha=0.9\n",
    "    )\n",
    "    lineas_recorrido.append(linea)\n",
    "\n",
    "# Creamos una leyenda\n",
    "elementos_leyenda = [\n",
    "    Line2D(\n",
    "        [0], [0],\n",
    "        marker=\"o\",\n",
    "        linestyle=\"None\",\n",
    "        markerfacecolor=colores[grupo],\n",
    "        markeredgecolor=\"none\",\n",
    "        label=f\"Grupo {grupo}\"\n",
    "    )\n",
    "    for grupo in range(k_demo)\n",
    "]\n",
    "\n",
    "elementos_leyenda.append(\n",
    "    Line2D(\n",
    "        [0], [0],\n",
    "        marker=\"X\",\n",
    "        linestyle=\"None\",\n",
    "        markerfacecolor=\"black\",\n",
    "        markeredgecolor=\"black\",\n",
    "        label=\"Centroide\"\n",
    "    )\n",
    ")\n",
    "\n",
    "ax.legend(handles=elementos_leyenda)\n",
    "ax.set_xlabel(\"Grocery estandarizado\")\n",
    "ax.set_ylabel(\"Detergents_Paper estandarizado\")\n",
    "ax.set_title(\"Cómo K-Means asigna clientes y mueve los centroides\")\n",
    "ax.grid(alpha=0.2)\n",
    "\n",
    "\n",
    "def actualizar_grafica(paso):\n",
    "    # Antes de la primera asignación, todos los puntos aparecen grises\n",
    "    if paso == 0:\n",
    "        puntos.set_facecolors(\"lightgray\")\n",
    "        ax.set_title(\"Inicio: posiciones iniciales de los centroides\")\n",
    "\n",
    "    # En cada paso coloreamos los puntos según su grupo\n",
    "    else:\n",
    "        grupos = grupos_historial[paso - 1]\n",
    "        puntos.set_facecolors(colores[grupos])\n",
    "        ax.set_title(\n",
    "            f\"Iteración {paso}: asignar clientes y recalcular centroides\"\n",
    "        )\n",
    "\n",
    "    # Movemos las X a las nuevas posiciones de los centroides\n",
    "    centros_paso = centros_historial[paso]\n",
    "    centroides.set_offsets(centros_paso)\n",
    "\n",
    "    # Mostramos el recorrido de cada centroide\n",
    "    historial = np.array(centros_historial[:paso + 1])\n",
    "\n",
    "    for grupo in range(k_demo):\n",
    "        recorrido = historial[:, grupo, :]\n",
    "        lineas_recorrido[grupo].set_data(\n",
    "            recorrido[:, 0],\n",
    "            recorrido[:, 1]\n",
    "        )\n",
    "\n",
    "    return [puntos, centroides] + lineas_recorrido\n",
    "\n",
    "\n",
    "animacion = FuncAnimation(\n",
    "    fig,\n",
    "    actualizar_grafica,\n",
    "    frames=len(centros_historial),\n",
    "    interval=1000,\n",
    "    repeat=True,\n",
    "    blit=False\n",
    ")\n",
    "\n",
    "plt.close(fig)\n",
    "display(HTML(animacion.to_jshtml()))\n",
    "\n",
    "print(\"Iteraciones realizadas:\", len(grupos_historial))"
   ]
  },
